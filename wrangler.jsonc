{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sultan-invitation",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mumtaz-invitations",
      "database_id": "dfeca9e2-e920-466a-8d5d-49be01a1a121"
    }
  ]
}
