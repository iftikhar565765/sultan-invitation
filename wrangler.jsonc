{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sultan-invitation",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sultan-invitations",
      "database_id": "db21649e-0d21-47cc-99bf-61be5d7b5655"
    }
  ]
}
